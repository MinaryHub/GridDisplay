<?xml version="1.0" encoding="utf-8"?>
<!--
  Package manifest for the MSIX build.

  build-msix.ps1 copies this file next to the published binaries and stamps the identity values into
  that copy before packing: Identity/@Version (from <Version> in GridDisplay.csproj),
  Identity/@Name, Identity/@Publisher, Properties/PublisherDisplayName and Properties/DisplayName
  (from its own parameters).

  Those five are parameters and not constants because Microsoft Store dictates all of them. Reserve
  the app name in Partner Center, then read Product identity off that page and pass it in:

      -IdentityName          Package/Identity/Name        e.g. 12345SMIC.GridDisplay
      -Publisher             Package/Identity/Publisher   e.g. CN=A1B2C3D4-....
      -PublisherDisplayName  publisher display name       e.g. SMIC
      -DisplayName           the reserved app name        e.g. Grid Display

  A package whose identity does not match the reservation character for character is rejected at
  upload, and Identity/@Publisher additionally has to match the signing certificate's subject when
  the package is sideloaded rather than uploaded.

  EntryPoint="Windows.FullTrustApplication" is what makes this a packaged desktop app rather than a
  UWP one: the low-level input hooks and the SetParent reparenting the wall is built on need full
  trust, and runFullTrust below is the capability that grants it.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="SMIC.GridDisplay"
    Publisher="CN=SMIC"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Grid Display</DisplayName>
    <PublisherDisplayName>SMIC</PublisherDisplayName>
    <Description>브라우저와 프로그램을 격자로 배치하는 디스플레이 월</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!--
      17763 (1809) is the floor for AddPackageByAppInstallerFileAsync, which is how a sideloaded
      package installs its own updates. It is also SupportedOSPlatformVersion in the csproj.
      MaxVersionTested has to name a Windows the app was actually tried on; the Store shows it as
      the supported range, and leaving it at an old build makes new Windows installs look unsupported.
    -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <!-- First entry is the default language. Both are listed because the UI is Korean and the
         Store listing is offered in English too; Partner Center matches listing languages
         against this list. -->
    <Resource Language="ko-KR" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <!-- Id is the AUMID's application part. UpdateService.AppId repeats it to relaunch the wall
         after an update that forced a shutdown; the two must stay in sync. -->
    <Application Id="GridDisplay" Executable="GridDisplay.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Grid Display"
        Description="브라우저와 프로그램을 격자로 배치하는 디스플레이 월"
        BackgroundColor="#0E0E10"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <!-- Every tile size the shell can ask for, so none of them is an upscaled 150x150. -->
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          ShortName="Grid Display" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!--
      Restricted, and the only capability this app declares. Store submission asks for a
      justification for it: the wall reparents other applications' windows with SetParent and
      intercepts input with low-level hooks, neither of which a UWP-sandboxed process can do.
      Packaged desktop apps are the intended users of runFullTrust, so it is granted routinely -
      but the justification field is not optional. See packaging\README.md.
    -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
